# =============================================================================
# Render Environment Variables
# Service URL: https://developer-emergency-handbook-api.onrender.com
# Paste these into Render → your service → Environment
# =============================================================================

# live = app can attach real DB URIs (recommended for this deploy)
DEH_MODE=live

# Must listen on all interfaces in the container
DEH_HOST=0.0.0.0

# Do NOT set DEH_PORT on Render — Render injects PORT automatically.
# The gateway now reads: PORT → DEH_PORT → 43124

DEH_RETENTION_INTERVAL_MS=60000
DEH_SYNC_INTERVAL_MS=60000

# Persist state on the instance (note: free Render disk is ephemeral unless you add a Disk)
DEH_DATA_PATH=./data/gateway-state.json

# Atlas / public cloud DB hosts are fine. Keep false unless you need private IPs.
DEH_ALLOW_PRIVATE_DB=false

# Discover/sync only — do not delete source documents from Mongo/Postgres
DEH_ENABLE_MONGODB=0
DEH_ENABLE_POSTGRES=0

# REQUIRED for stable encrypt/decrypt across restarts (32 bytes, base64).
# Generate once:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If this changes, previously saved DB URIs cannot be decrypted.
DEH_MASTER_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# Optional: switch to production mode (adds Bearer admin auth on all /api/v1/* except health)
# DEH_MODE=production
# DEH_ADMIN_TOKEN=REPLACE_WITH_LONG_RANDOM_TOKEN
# DEH_MASTER_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
