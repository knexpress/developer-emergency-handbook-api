# live = real DB URIs from the app (default). demo = optional seed. production = token + master key.
DEH_MODE=live
DEH_HOST=127.0.0.1
DEH_PORT=43124
DEH_RETENTION_INTERVAL_MS=60000
DEH_SYNC_INTERVAL_MS=60000
DEH_DATA_PATH=./data/gateway-state.json
DEH_ALLOW_PRIVATE_DB=true

# Remote purge drivers are OFF by default (discover/sync still work). Set to 1 to allow deletes.
# DEH_ENABLE_MONGODB=0
# DEH_ENABLE_POSTGRES=0

# Optional: set DEH_SEED_DEMO=1 with DEH_MODE=demo to load the old illustrative seed.
# DEH_MODE=demo
# DEH_SEED_DEMO=1

# Production only.
# DEH_MODE=production
# DEH_ADMIN_TOKEN=
# DEH_MASTER_KEY=

# -----------------------------------------------------------------------------
# Render deploy (https://developer-emergency-handbook-api.onrender.com)
# See render.env.example — host 0.0.0.0, set DEH_MASTER_KEY, do not set DEH_PORT
# (Render provides PORT). Flutter / APK:
#   --dart-define=API_BASE=https://developer-emergency-handbook-api.onrender.com
# -----------------------------------------------------------------------------
